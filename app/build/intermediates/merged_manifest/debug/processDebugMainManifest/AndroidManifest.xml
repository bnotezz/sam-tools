<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samtools.debug"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Allow querying Tailscale package on Android 11+ (API 30+) -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <permission
        android:name="com.samtools.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.samtools.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.samtools.SamToolsApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@null"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@null"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SamTools" >

        <!-- Main Dashboard & Settings Activity -->
        <activity
            android:name="com.samtools.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SamTools" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Save to Downloads Share Sheet Target Activity -->
        <activity
            android:name="com.samtools.ui.SaveToDownloadsActivity"
            android:exported="true"
            android:icon="@drawable/ic_download"
            android:label="@string/download"
            android:theme="@style/Theme.SamTools.Translucent" >
            <intent-filter android:label="@string/download" >
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <!-- Comprehensive mime types for maximum share-sheet compatibility -->
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity> <!-- Activity Alias for Google Files "Save to Downloads" compatibility -->
        <activity-alias
            android:name="com.google.android.apps.nbu.files.gateway.savetodownloads.SaveToDownloadsActivity"
            android:exported="true"
            android:icon="@drawable/ic_download"
            android:label="@string/download"
            android:targetActivity="com.samtools.ui.SaveToDownloadsActivity" >
            <intent-filter android:label="@string/download" >
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- Zero-UI Launcher Shortcut Trampoline -->
        <activity
            android:name="com.samtools.ui.ShortcutTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.SamTools.Trampoline" >
            <intent-filter>
                <action android:name="com.samtools.action.SHORTCUT_TAILSCALE_CONNECT" />
                <action android:name="com.samtools.action.SHORTCUT_TAILSCALE_DISCONNECT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.samtools.debug.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>