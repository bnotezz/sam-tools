<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="tailscale_connect"
        android:enabled="true"
        android:icon="@drawable/ic_tailscale_connect"
        android:shortcutShortLabel="@string/shortcut_tailscale_connect_short"
        android:shortcutLongLabel="@string/shortcut_tailscale_connect_label">
        <intent
            android:action="com.samtools.action.SHORTCUT_TAILSCALE_CONNECT"
            android:targetPackage="com.samtools"
            android:targetClass="com.samtools.ui.ShortcutTrampolineActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="tailscale_disconnect"
        android:enabled="true"
        android:icon="@drawable/ic_tailscale_disconnect"
        android:shortcutShortLabel="@string/shortcut_tailscale_disconnect_short"
        android:shortcutLongLabel="@string/shortcut_tailscale_disconnect_label">
        <intent
            android:action="com.samtools.action.SHORTCUT_TAILSCALE_DISCONNECT"
            android:targetPackage="com.samtools"
            android:targetClass="com.samtools.ui.ShortcutTrampolineActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
